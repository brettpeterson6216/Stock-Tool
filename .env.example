# Copy this file to ".env" and fill in real values before starting the server.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Long random string used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# ── Market data ──────────────────────────────────────────────────────────────
# Finnhub API key (https://finnhub.io) — REQUIRED
FINNHUB_KEY=your-finnhub-api-key-here

# SEC asks automated clients to identify the application and a monitored contact.
SEC_USER_AGENT=ImpliedLens/1.2 data-contact@your-domain.com

# ── Database (Turso / libSQL) ─────────────────────────────────────────────────
# For local dev you can use a file DB:  TURSO_URL=file:/tmp/impliedlens.db
TURSO_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ── Stripe (required in production) ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# ── Email (Resend — https://resend.com) ──────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@impliedlens.com

# ── Admin ─────────────────────────────────────────────────────────────────────
# Long secret passed via X-Admin-Secret header to POST /api/admin/grant-pro
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=replace-with-a-long-random-secret

# ── App URL (no trailing slash) ──────────────────────────────────────────────
APP_URL=https://impliedlens.com

# ── Gifted Pro emails (comma-separated, optional) ────────────────────────────
# Users whose email matches get Pro access without Stripe
# GIFTED_EMAILS=user1@example.com,user2@example.com

# ── Technical read narration (optional) ──────────────────────────────────────
# Without a key the technical read still works — it renders the deterministic
# prose generated from the computed signals. With a key, Claude narrates those
# same computed signals in plainer language. It never sees raw price history
# and never introduces a number that is not in the signal set.
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5
